# REQUIRED: local/direct PostgreSQL connection (session-mode required by pg-boss).
DATABASE_URL=postgres://caller:local-development-only@localhost:54329/caller
# REQUIRED for database tests; use a dedicated local database, never production.
TEST_DATABASE_URL=postgres://caller:local-development-only@localhost:54329/caller
# REQUIRED: exact origin, no trailing slash. HTTPS in production.
PUBLIC_BASE_URL=http://localhost:3000
# OPTIONAL: 3000 by default; NODE_ENV=production in deployed image.
PORT=3000
NODE_ENV=development
# REQUIRED in production: independent random 32+ character session-cookie signing secret.
SESSION_SECRET=
# REQUIRED for external destination sends: independent random HMAC key, shared with receiver.
WEBHOOK_SIGNING_SECRET=
# REQUIRED for first account: email + 12+ character password; no default in source runtime.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# OPTIONAL: false by default. Explicitly true ONLY for labelled offline simulations.
MOCK_MODE=false
# OPTIONAL: production images reject mocks unless this explicit flag is also true.
ALLOW_DEPLOYED_SIMULATION=false
# Speech defaults. Keys REQUIRED for live browser and phone calls.
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
# Use separate Gnani keys if supplied by the hackathon; GNANI_API_KEY remains a shared-key fallback.
GNANI_STT=
GNANI_TTS=
GNANI_API_KEY=
# Speech endpoint silence threshold (300-1000 ms). Raise to 500 if natural pauses are clipped.
GNANI_MIN_SILENCE_MS=350
# OPTIONAL: explicitly selected fallback, never automatically mocks.
STT_FALLBACK=
TTS_FALLBACK=
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE_ID=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# REQUIRED for live dialogue and post-call notes. Groq Qwen 3.8 27B is the default.
GROQ_API_KEY=
# OPTIONAL: choose another compatible dialogue provider or model.
DIALOGUE_PROVIDER=
DIALOGUE_MODEL=
DIALOGUE_URL=
DIALOGUE_API_KEY=
# REQUIRED for live PSTN only; browser calls do not need Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# REQUIRED for local live calls: a public HTTPS tunnel or deployed URL, without trailing slash.
# Keep PUBLIC_BASE_URL as the exact dashboard origin for login and browser WebSocket checks.
TWILIO_WEBHOOK_BASE_URL=
# OPTIONAL operational limits (configuration is not a measured capacity claim).
GLOBAL_CONCURRENCY=4
MAX_CONTACT_ROWS=200
DRAIN_SECONDS=25
IDLE_TIMEOUT_SECONDS=25
LOG_LEVEL=info
# OPTIONAL diagnostics: explicit flags consume credits. Use synthetic/consented fixture only.
RUN_LIVE_GNANI=false
GNANI_SPIKE_PCM=
RUN_LIVE_EVAL=false
LOAD_CLIENTS=4
SMOKE_BASE_URL=http://localhost:3000
SMOKE_DESTINATION_ID=
# E2E browser: chrome locally; chromium in CI.
PW_CHANNEL=chrome
TEST_BASE_URL=http://localhost:3000
# Fly API token is supplied to flyctl/GitHub, not to the browser or application.
# FLY_API_TOKEN=   (CI secret; optional until deployment)
# WhatsApp/SMS and Sentry are intentionally not wired into this runtime; legacy scripts are unmounted.
